            "id": "{5d101f2f-89fe-4dc8-8350-63d0c36a6588}",
            "model": {
                "data": {
                    "console": "",
                    "height": 430,
                    "js_code": "// ====================================\n// NO TARGET BIRD\n// CiRA CORE -> MQTT\n// ====================================\n\npayload.topic = \"birdtrack/esp32/device01/detection\";\n\npayload.detected = false;\npayload.name = \"none\";\npayload.action = \"NO_BIRD\";\n\npayload.debug_bird = {\n\tdetected: false,\n\taction: \"NO_BIRD\"\n};\n\nprint(\"[BIRD] No target bird\");\nprint(\"[MQTT] Publish NO_BIRD\");\n\npayload;",
