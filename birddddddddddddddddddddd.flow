        {
            "id": "{5cdee603-fa4c-42e5-b0fc-5eee09c35c68}",
            "model": {
                "data": {
                    "console": "",
                    "height": 430,
                    "js_code": "// ============================================\n// BIRD DETECTION - CiRA CORE DEEPDETECT\n// ============================================\n\nvar birdList = [\n\t\"pigeon\",\n\t\"pigeonscoop\",\n\t\"dove\",\n\t\"wren\"\n];\n\n// --------------------------------------------\n// อ่านข้อมูลจาก DeepDetect\n// --------------------------------------------\n\nvar deep = payload.DeepDetect || {};\n\nvar objects = deep.objects || [];\nvar counts = deep.counts || {};\n\n// --------------------------------------------\n// ตรวจชื่อนก\n// --------------------------------------------\n\nvar detected = false;\nvar birdName = \"none\";\nvar confidence = 0;\n\n// ตรวจจาก objects\nfor (var i = 0; i < objects.length; i++) {\n\n\tvar obj = objects[i];\n\n\tvar rawName = obj.name || \"\";\n\n\tvar normalizedName = String(rawName)\n\t\t.toLowerCase()\n\t\t.trim();\n\n\tvar objConfidence = Number(obj.confidence || 0);\n\n\tif (birdList.indexOf(normalizedName) !== -1) {\n\n\t\tdetected = true;\n\t\tbirdName = normalizedName;\n\t\tconfidence = objConfidence;\n\n\t\tbreak;\n\t}\n}\n\n// --------------------------------------------\n// ตรวจจาก counts สำรอง\n// กรณี objects ไม่มีข้อมูล\n// --------------------------------------------\n\nif (!detected && objects.length === 0) {\n\n\tfor (var key in counts) {\n\n\t\tif (counts.hasOwnProperty(key)) {\n\n\t\t\tvar normalizedKey = String(key)\n\t\t\t\t.toLowerCase()\n\t\t\t\t.trim();\n\n\t\t\tvar count = Number(counts[key] || 0);\n\n\t\t\tif (\n\t\t\t\tbirdList.indexOf(normalizedKey) !== -1 &&\n\t\t\t\tcount > 0\n\t\t\t) {\n\n\t\t\t\tdetected = true;\n\t\t\t\tbirdName = normalizedKey;\n\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t}\n}\n\n// --------------------------------------------\n// ส่งข้อมูลต่อ\n// --------------------------------------------\n\npayload.topic = \"birdtrack/esp32/device01/detection\";\n\npayload.detected = detected;\npayload.name = birdName;\npayload.confidence = confidence;\n\nif (detected) {\n\n\tpayload.action = \"BIRD_DETECTED\";\n\n} else {\n\n\tpayload.action = \"NO_BIRD\";\n}\n\n// --------------------------------------------\n// DEBUG\n// --------------------------------------------\n\npayload.debug_bird = {\n\tdeepdetect_count: deep.count || 0,\n\tobjects_count: objects.length,\n\tbird_name: birdName,\n\tconfidence: confidence,\n\tdetected: detected,\n\taction: payload.action\n};\n\nprint(\"[DEEPDETECT] Objects: \" + objects.length);\nprint(\"[BIRD] Name: \" + birdName);\nprint(\"[BIRD] Detected: \" + detected);\nprint(\"[BIRD] Confidence: \" + confidence);\nprint(\"[ACTION] \" + payload.action);\n\npayload;",
