                "python_code": "# -*- coding: utf-8 -*-\n# ========================================================\n# CiRA CORE\n# DeepDetect Bird Detection -> MQTT -> ESP32\n# ========================================================\n\nimport json\nimport time\nimport paho.mqtt.client as mqtt\n\n# ========================================================\n# MQTT CONFIG\n# ========================================================\n\nMQTT_BROKER = \"broker.emqx.io\"\nMQTT_PORT = 1883\n\nMQTT_TOPIC = \"birdtrack/esp32/device01/detection\"\n\nTARGET_BIRDS = [\n\t\"pigeon\",\n\t\"pigeonscoop\",\n\t\"dove\",\n\t\"wren\"\n]\n\nCOOLDOWN_SEC = 60.0\nNO_BIRD_INTERVAL = 5.0\n\n# ========================================================\n# GLOBAL\n# ========================================================\n\nif \"last_alert_time\" not in globals():\n\tlast_alert_time = 0.0\n\nif \"last_no_bird_time\" not in globals():\n\tlast_no_bird_time = 0.0\n\nif \"mqtt_client\" not in globals():\n\tmqtt_client = None\n\nif \"mqtt_connected\" not in globals():\n\tmqtt_connected = False\n\n# ========================================================\n# MQTT CONNECT\n# ========================================================\n\ndef init_mqtt():\n\n\tglobal mqtt_client\n\tglobal mqtt_connected\n\n\tif mqtt_client is not None:\n\n\t\ttry:\n\t\t\tif mqtt_client.is_connected():\n\t\t\t\tmqtt_connected = True\n\t\t\t\treturn True\n\t\texcept Exception:\n\t\t\tpass\n\n\ttry:\n\n\t\ttry:\n\t\t\tmqtt_client = mqtt.Client(\n\t\t\t\tmqtt.CallbackAPIVersion.VERSION2\n\t\t\t)\n\n\t\texcept AttributeError:\n\t\t\tmqtt_client = mqtt.Client()\n\n\t\tmqtt_client.connect(\n\t\t\tMQTT_BROKER,\n\t\t\tMQTT_PORT,\n\t\t\t60\n\t\t)\n\n\t\tmqtt_client.loop_start()\n\n\t\tmqtt_connected = True\n\n\t\tprint(\"[MQTT] Connected\")\n\n\t\treturn True\n\n\texcept Exception as e:\n\n\t\tmqtt_connected = False\n\n\t\tprint(\"[MQTT] Connection error:\", e)\n\n\t\treturn False\n\n# ========================================================\n# MQTT PUBLISH\n# ========================================================\n\ndef publish_detection(detected, bird_name, action):\n\n\tglobal mqtt_client\n\tglobal mqtt_connected\n\n\tif not mqtt_connected or mqtt_client is None:\n\n\t\tprint(\"[MQTT] Not connected\")\n\t\treturn False\n\n\ttry:\n\n\t\tmessage = {\n\t\t\t\"detected\": bool(detected),\n\t\t\t\"name\": str(bird_name),\n\t\t\t\"action\": str(action)\n\t\t}\n\n\t\tmessage_json = json.dumps(message)\n\n\t\tresult = mqtt_client.publish(\n\t\t\tMQTT_TOPIC,\n\t\t\tmessage_json,\n\t\t\tqos=1\n\t\t)\n\n\t\tresult.wait_for_publish(timeout=3)\n\n\t\tprint(\"[MQTT] Topic:\", MQTT_TOPIC)\n\t\tprint(\"[MQTT] Payload:\", message_json)\n\t\tprint(\"[MQTT] Publish result:\", result.rc)\n\n\t\treturn result.rc == 0\n\n\texcept Exception as e:\n\n\t\tprint(\"[MQTT] Publish error:\", e)\n\n\t\treturn False\n\n# ========================================================\n# READ CiRA CORE PAYLOAD\n# ========================================================\n\ntry:\n\n\tinput_data = payload\n\nexcept NameError:\n\n\tinput_data = None\n\nprint(\"\")\nprint(\"========================================\")\nprint(\"[DEBUG] Input:\", repr(input_data))\nprint(\"========================================\")\n\n# ========================================================\n# DETECTION PARSER\n# ========================================================\n\ndetected = False\nbird_name = \"none\"\nconfidence = 0.0\nbird_count = 0\n\ntry:\n\n\tif isinstance(input_data, dict):\n\n\t\t# ----------------------------------------\n\t\t# DeepDetect data\n\t\t# ----------------------------------------\n\n\t\tdeep = input_data.get(\"DeepDetect\", {})\n\n\t\tif isinstance(deep, dict):\n\n\t\t\tobjects = deep.get(\"objects\", [])\n\t\t\tcounts = deep.get(\"counts\", {})\n\n\t\t\tbird_count = deep.get(\"count\", 0)\n\n\t\t\t# ------------------------------------\n\t\t\t# Check objects\n\t\t\t# ------------------------------------\n\n\t\t\tif isinstance(objects, list):\n\n\t\t\t\tfor obj in objects:\n\n\t\t\t\t\tif not isinstance(obj, dict):\n\t\t\t\t\t\tcontinue\n\n\t\t\t\t\traw_name = obj.get(\"name\", \"\")\n\n\t\t\t\t\tnormalized_name = str(\n\t\t\t\t\t\traw_name\n\t\t\t\t\t).lower().strip()\n\n\t\t\t\t\tobj_confidence = float(\n\t\t\t\t\t\tobj.get(\"confidence\", 0.0)\n\t\t\t\t\t)\n\n\t\t\t\t\tprint(\n\t\t\t\t\t\t\"[DEBUG] Object:\",\n\t\t\t\t\t\tnormalized_name,\n\t\t\t\t\t\t\"Confidence:\",\n\t\t\t\t\t\tobj_confidence\n\t\t\t\t\t)\n\n\t\t\t\t\tif normalized_name in TARGET_BIRDS:\n\n\t\t\t\t\t\tdetected = True\n\n\t\t\t\t\t\tbird_name = normalized_name\n\n\t\t\t\t\t\tconfidence = obj_confidence\n\n\t\t\t\t\t\tbird_count += 0 if bird_count else 1\n\n\t\t\t\t\t\tbreak\n\n\t\t\t# ------------------------------------\n\t\t\t# Fallback: counts\n\t\t\t# ------------------------------------\n\n\t\t\tif not detected and isinstance(counts, dict):\n\n\t\t\t\tfor key, value in counts.items():\n\n\t\t\t\t\tnormalized_name = str(\n\t\t\t\t\t\tkey\n\t\t\t\t\t).lower().strip()\n\n\t\t\t\t\tcount = int(value or 0)\n\n\t\t\t\t\tprint(\n\t\t\t\t\t\t\"[DEBUG] Count:\",\n\t\t\t\t\t\tnormalized_name,\n\t\t\t\t\t\tcount\n\t\t\t\t\t)\n\n\t\t\t\t\tif (\n\t\t\t\t\t\tnormalized_name in TARGET_BIRDS\n\t\t\t\t\t\tand count > 0\n\t\t\t\t\t):\n\n\t\t\t\t\t\tdetected = True\n\n\t\t\t\t\t\tbird_name = normalized_name\n\n\t\t\t\t\t\tbird_count = count\n\n\t\t\t\t\t\tbreak\n\n\t\t# ----------------------------------------\n\t\t# Fallback: flat payload\n\t\t# ----------------------------------------\n\n\t\tif not detected:\n\n\t\t\traw_name = (\n\t\t\t\tinput_data.get(\"name\")\n\t\t\t\tor input_data.get(\"label\")\n\t\t\t\tor input_data.get(\"class\")\n\t\t\t\tor input_data.get(\"class_name\")\n\t\t\t\tor \"\"\n\t\t\t)\n\n\t\t\tnormalized_name = str(\n\t\t\t\traw_name\n\t\t\t).lower().strip()\n\n\t\t\tif normalized_name in TARGET_BIRDS:\n\n\t\t\t\tdetected = True\n\n\t\t\t\tbird_name = normalized_name\n\n\tprint(\"[DEBUG] Bird count:\", bird_count)\n\tprint(\"[DEBUG] Bird name:\", bird_name)\n\tprint(\"[DEBUG] Confidence:\", confidence)\n\tprint(\"[DEBUG] Detected:\", detected)\n\nexcept Exception as e:\n\n\tprint(\"[ERROR] Detection parsing:\", e)\n\n# ========================================================\n# MQTT\n# ========================================================\n\nif init_mqtt():\n\n\tcurrent_time = time.time()\n\n\t# ============================================\n\t# TARGET BIRD DETECTED\n\t# ============================================\n\n\tif detected:\n\n\t\tprint(\"\")\n\t\tprint(\"[BIRD] DETECTED:\", bird_name)\n\t\tprint(\"[BIRD] Count:\", bird_count)\n\t\tprint(\"[BIRD] Confidence:\", confidence)\n\n\t\t# Cooldown\n\t\tif current_time - last_alert_time >= COOLDOWN_SEC:\n\n\t\t\tprint(\"[ACTION] Publish BIRD_DETECTED\")\n\n\t\t\tsuccess = publish_detection(\n\t\t\t\tTrue,\n\t\t\t\tbird_name,\n\t\t\t\t\"BIRD_DETECTED\"\n\t\t\t)\n\n\t\t\tif success:\n\n\t\t\t\tlast_alert_time = current_time\n\n\t\t\t\tprint(\"[SUCCESS] BIRD_DETECTED sent\")\n\n\t\telse:\n\n\t\t\tremaining = COOLDOWN_SEC - (\n\t\t\t\tcurrent_time - last_alert_time\n\t\t\t)\n\n\t\t\tprint(\n\t\t\t\t\"[BIRD] Cooldown: %.1f seconds\"\n\t\t\t\t% remaining\n\t\t\t)\n\n\t# ============================================\n\t# NO TARGET BIRD\n\t# ============================================\n\n\telse:\n\n\t\tprint(\"[BIRD] No target bird\")\n\n\t\tif (\n\t\t\tcurrent_time - last_no_bird_time\n\t\t\t>= NO_BIRD_INTERVAL\n\t\t):\n\n\t\t\tsuccess = publish_detection(\n\t\t\t\tFalse,\n\t\t\t\t\"none\",\n\t\t\t\t\"NO_BIRD\"\n\t\t\t)\n\n\t\t\tif success:\n\n\t\t\t\tlast_no_bird_time = current_time\n\n\t\t\t\tprint(\"[SUCCESS] NO_BIRD sent\")\n\nelse:\n\n\tprint(\"[MQTT] Waiting for connection\")",
